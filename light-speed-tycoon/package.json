{
  "name": "light-speed-tycoon",
  "private": true,
  "version": "0.1.0",
  "description": "A fun-first city-builder/tycoon about building and running a fiber ISP.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "pixi.js": "8.21.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.19.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
